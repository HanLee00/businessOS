{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ohvenus-daily-pnl",
  "main": "src/index.mjs",
  "compatibility_date": "2026-09-02",
  "workers_dev": true,
  "preview_urls": false,
  "triggers": {
    "crons": ["0 4 * * *"]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "EASYPARCEL_TOKEN_VAULT",
        "class_name": "EasyParcelTokenVault"
      },
      {
        "name": "PNL_RUN_STATE",
        "class_name": "OhVenusPnlState"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["EasyParcelTokenVault"]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["OhVenusPnlState"]
    }
  ],
  "vars": {
    "MODE": "preview_only",
    "TIME_ZONE": "Asia/Kuala_Lumpur",
    "SHOPIFY_SHOP_DOMAIN": "9s4j4j-8d.myshopify.com",
    "SHOPIFY_PRIMARY_DOMAIN": "ohvenus.shop",
    "META_GRAPH_VERSION": "v26.0",
    "META_AD_ACCOUNT_ID": "act_1383191923615307",
    "META_AD_ACCOUNT_NAME": "OHVENUS",
    "META_AD_ACCOUNT_CURRENCY": "MYR",
    "META_AD_ACCOUNT_TIME_ZONE": "Asia/Kuala_Lumpur",
    "EASYPARCEL_REDIRECT_URI": "http://127.0.0.1:8080/callback",
    "EASYPARCEL_ACCOUNT_REGION": "Malaysia",
    "ZOHO_ORGANIZATION_ID": "933897042"
  }
}
