# Existing EasyParcel Individual API credential (legacy account check only)
EASYPARCEL_API_KEY=

# Current EasyParcel OAuth credential (required for shipment prices)
EASYPARCEL_ACCESS_TOKEN=

# Optional application details used to generate the authorization URL
EASYPARCEL_CLIENT_ID=
EASYPARCEL_CLIENT_SECRET=
EASYPARCEL_REDIRECT_URI=http://127.0.0.1:8080/callback
EASYPARCEL_REFRESH_TOKEN=
EASYPARCEL_TOKEN_EXPIRES_AT=
